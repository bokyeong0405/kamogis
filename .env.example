# 이 파일을 .env로 복사한 뒤 비밀번호를 직접 채운다. .env는 커밋되지 않는다.
#
#   cp .env.example .env
#   set -a; source .env; set +a     # docker compose와 mvn 양쪽에 필요
#
# docker compose는 같은 디렉터리의 .env를 자동으로 읽지만, mvn/java는 읽지 않는다.
# 그래서 셸에 먼저 불러온 뒤 실행한다. 비밀번호가 없으면 연결 전에 바로 멈춘다.

# PostgreSQL + PostGIS
PG_DB=kamogis
PG_USER=kamogis
PG_PASSWORD=
PG_PORT=55432
PG_URL=jdbc:postgresql://127.0.0.1:55432/kamogis

# MongoDB (통합·분리 모델 비교 실험용)
MONGO_USER=kamogis
MONGO_PASSWORD=
MONGO_PORT=57017
MONGO_HOST=127.0.0.1:57017
# 위 조각 대신 접속 문자열을 통째로 주려면 MONGO_URI를 설정한다(설정 시 우선).
# MONGO_URI=mongodb://kamogis:...@127.0.0.1:57017/?authSource=admin&serverSelectionTimeoutMS=5000

# 조회 API 포트
API_PORT=58080
